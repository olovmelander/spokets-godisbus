+/**
+ * Pause holds the line being said where it is, as its bubble waits under Pause; `resumeVoice` lets it finish. A line is
+ * cut only when the player goes on from it, or starts again from a big candy.
+ */
+export function pauseVoice(): void {
+  pendingKey = null;
+  try {
+    currentAudio?.pause();
+  } catch {
+    // ignore
+  }
+}
+
+/** Back from Pause: the line that was being said goes on from where it was. */
+export function resumeVoice(): void {
+  const audio = currentAudio;
+  if (!audio || !audio.paused || !soundEnabled || currentVolume <= 0) return;
+  try {
+    audio.play()?.catch(() => {
+      if (currentAudio !== audio) return;
+      currentAudio = null;
+      currentKey = null;
+    });
+  } catch {
+    stopVoice();
+  }
+}
+
 /** Stops any currently playing voice line. */
 export function stopVoice(): void {
   pendingKey = null;
