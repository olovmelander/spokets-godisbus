-    top = car_top(x) - 0.07
-    t = 0.0 if top <= belt else min(1.0, max(0.0, (z - belt) / (top - belt)))
-    return Vector((x, side * (car_wide(x) * 0.975 + (CAR_ROOF + 0.02 - car_wide(x) * 0.975) * t + 0.022), z))
-
-
-def build_car(name, COAT, seed):
