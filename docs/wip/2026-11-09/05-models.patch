+            groups = {
+                'hips': top,
+                'thigh_' + ('l' if s > 0 else 'r'): knee * (1.0 - top),
+                'calf_' + ('l' if s > 0 else 'r'): (1.0 - knee) * (1.0 - hem * 0.8),
