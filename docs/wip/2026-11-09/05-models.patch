+            sn = math.sin(a)
+            bulge = 0.0
+            # The hands in the pockets: a soft swelling low on each side, a little forward.
+            if 9.4 < z < 11.6:
+                bulge = 0.14 * max(0.0, abs(sn) - 0.55) / 0.45 * max(0.0, 1.0 - abs(c - 0.25) * 1.6) * math.sin((z - 9.4) / 2.2 * math.pi)
