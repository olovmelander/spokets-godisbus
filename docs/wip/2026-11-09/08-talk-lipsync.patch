+        out.turn += k * 0.05 * Math.sin(t * 1.3 + phase * 0.7);
+        out.twist += k * 0.03 * Math.sin(t * 1.6 + phase + 1);
+        out.bendSide += k * 0.018 * Math.sin(t * 1.15 + phase + 2);
+        out.lean += k * 0.012 * beat.at;
+      }
+      if (gesture.at > 1e-4) {
