+      if (inWord) first = true;
+      inWord = false;
+      const pause = c === '…' ? TRAIL : c === '.' || c === '!' || c === '?' ? STOP
+        : c === ',' || c === ';' || c === ':' || c === '–' || c === '-' ? COMMA : c === ' ' ? WORD : 0;
