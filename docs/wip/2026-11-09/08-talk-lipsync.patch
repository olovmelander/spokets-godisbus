+      // lifts, and the head with it.
+      if (held > 1e-3 && !calmNow) {
+        const breath = Math.sin(clock * 1.7 + phase) + 0.3 * Math.sin(clock * 0.43 + 2 * phase);
+        out.lean -= 0.009 * held * breath;
+        out.nod += 0.007 * held * breath;
+      }
+    },
+  };
+}
