+            else one.nodes[i]!.set(one.top.x, one.top.y - i * body, one.top.z);
+          }
+          one.nodes[NODES - 1]!.copy(one.nodes[NODES - 2]!).setY(one.nodes[NODES - 2]!.y - END);
