+            v.addScaledVector(n, part);
+          }
+          const half = FRINGE.wide / 2;
+          pos[at * 3] = v.x - last.w.x * half; pos[at * 3 + 1] = v.y - last.w.y * half; pos[at * 3 + 2] = v.z - last.w.z * half + 0.005;
