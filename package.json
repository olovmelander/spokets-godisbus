{
  "name": "spokets-godisbus",
  "private": true,
  "version": "0.1.0",
  "description": "Elof och det stora godis\u00e4ventyret",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "npm run assets && vite",
    "dev:lan": "npm run assets && vite --host --mode lan",
    "build": "npm run assets && node scripts/clean-dist.mjs && vite build && node scripts/size-gate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "test:browser:opening": "node tests/browser/opening-story.mjs",
    "test:story-context": "node tests/browser/story-context.mjs",
    "test:browser:forest": "node tests/browser/forest-puzzles.mjs",
    "test:browser:mountain": "node tests/browser/mountain-loop.mjs",
    "test:browser:finale": "node tests/browser/finale-stage.mjs",
    "test:browser:models": "node tests/browser/model-installation.mjs"
  },
  "dependencies": {
    "planck": "1.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
