{
  "name": "spokets-godisbus",
  "private": true,
  "version": "0.1.0",
  "description": "Elof och det stora godisäventyret",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "npm run assets && vite",
    "dev:lan": "npm run assets && vite --host --mode lan",
    "build": "npm run assets && vite build && node scripts/size-gate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/smoke.mjs && node tests/browser/settings.mjs && node tests/browser/profiles.mjs && node tests/browser/photos.mjs && node tests/browser/photo-storage.mjs",
    "privacy-check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "planck": "1.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
